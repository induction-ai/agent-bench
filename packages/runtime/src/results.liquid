<!doctype html>
{%- comment -%}
  results.html for one run. Rendered by results_html.ts with output escaped
  by default, so transcript text can never become markup. The view it reads:
  the run's results.json fields, plus `title`, `stats`, `support` and the
  prepared `messages` (see prepareMessages).
{%- endcomment %}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f7f7f5; --surface: #ffffff; --border: #e2e2dd; --text: #1d1d1b;
    --muted: #6b6b66; --customer: #2f6fdb; --agent: #1f8a5b; --tool: #b7791f;
    --met: #1f8a5b; --unmet: #c2410c; --code-bg: #f1f1ee; --error-bg: #fdecea;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615; --surface: #1f1f1d; --border: #34342f; --text: #ececea;
      --muted: #9a9a93; --customer: #6ea0f5; --agent: #4cc38a; --tool: #e0a54a;
      --met: #4cc38a; --unmet: #f08a5d; --code-bg: #2a2a27; --error-bg: #3a1f1a;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 960px; margin: 0 auto; padding: 24px 16px 64px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 0 0 12px; }
  a { color: var(--customer); }
  .muted { color: var(--muted); }
  .meta { color: var(--muted); font-size: 13px; margin: 2px 0; }
  code, pre { font: 12.5px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 20px 0; }
  .stat, section, .msg { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .stat { padding: 12px 14px; }
  .stat-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .stat-value { font-size: 22px; font-weight: 600; }
  section { padding: 16px; margin: 0 0 16px; overflow-x: auto; }
  .error { background: var(--error-bg); border-color: var(--unmet); }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; }
  td.met { color: var(--met); font-weight: 700; }
  td.unmet { color: var(--unmet); font-weight: 700; }
  .msg { padding: 12px 14px; margin: 0 0 10px; border-left: 4px solid var(--border); }
  .msg.user { border-left-color: var(--customer); }
  .msg.assistant { border-left-color: var(--agent); }
  .msg.tool { border-left-color: var(--tool); }
  .msg header { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 6px; }
  .role { font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .user .role { color: var(--customer); } .assistant .role { color: var(--agent); } .tool .role { color: var(--tool); }
  .text { white-space: pre-wrap; overflow-wrap: anywhere; }
  .payload { margin: 6px 0; }
  .payload summary { cursor: pointer; font-size: 13px; }
  .payload-kind { font-weight: 600; }
  .payload pre { background: var(--code-bg); padding: 10px; border-radius: 6px; margin: 6px 0 0;
    white-space: pre-wrap; overflow-wrap: anywhere; max-height: 480px; overflow-y: auto; }
</style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <div class="meta">{{ provider }} · {{ model }}</div>
  <div class="meta">
    Run <code>{{ run_id }}</code> · {{ timestamp | datetime }}
    {%- if git_sha %} · commit
      {%- if git_url %} <a href="{{ git_url }}">{{ git_sha | slice: 0, 8 }}</a>
      {%- else %} {{ git_sha | slice: 0, 8 }}
      {%- endif %}
    {%- endif %}
  </div>
  {%- if support.size > 0 %}
  <div class="meta">
    {%- for s in support %}{% unless forloop.first %} · {% endunless %}{{ s.role }}: {{ s.model }}{% endfor -%}
  </div>
  {%- endif %}

  <div class="stats">
    <div class="stat"><div class="stat-label">Score</div><div class="stat-value">{% if score %}{{ score }}/10{% else %}Not scored{% endif %}</div>{% unless score %}<div class="muted">Run with --judge to score</div>{% endunless %}</div>
    <div class="stat"><div class="stat-label">Cost</div><div class="stat-value">{{ cost | format_cost }}</div></div>
    <div class="stat"><div class="stat-label">Customer turns</div><div class="stat-value">{{ customer_turns | format_number }}</div></div>
    <div class="stat"><div class="stat-label">Agent latency</div><div class="stat-value">{{ llm_latency_ms | format_latency }}</div></div>
  </div>

  {%- if error %}
  <section class="error"><h2>Error</h2><pre>{{ error }}</pre></section>
  {%- endif %}

  {%- if judge.criteria.size > 0 %}
  <section>
    <h2>Judge</h2>
    <table>
      <thead><tr><th></th><th>Criterion</th><th>Evidence</th></tr></thead>
      <tbody>
        {%- for c in judge.criteria %}
        <tr>
          {%- if c.met %}<td class="met">✓</td>{% else %}<td class="unmet">✗</td>{% endif -%}
          <td>{{ c.criterion }}</td><td class="muted">{{ c.evidence }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    {%- if reasoning %}<p class="muted">{{ reasoning }}</p>{% endif %}
  </section>
  {%- elsif reasoning %}
  <section><h2>Judge</h2><p>{{ reasoning }}</p></section>
  {%- endif %}

  {%- if usage_rows.size > 0 %}
  <section>
    <h2>Usage by role</h2>
    <table>
      <thead><tr><th>Role</th><th>Input</th><th>Cached</th><th>Output</th><th>Calls</th><th>Cost</th></tr></thead>
      <tbody>
        {%- for u in usage_rows %}
        <tr>
          <td>{{ u.role }}</td>
          <td>{{ u.input | format_number }}</td>
          <td>{{ u.cached_input | format_number }}</td>
          <td>{{ u.output | format_number }}</td>
          <td>{{ u.calls | format_number }}</td>
          <td>{{ u.cost_cents | format_cost }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>
  {%- endif %}

  <h2>Transcript</h2>
  {%- for msg in messages %}
  <article class="msg {{ msg.role }}">
    <header><span class="role">{{ msg.label }}</span><span class="muted">#{{ forloop.index }}</span></header>
    {%- for part in msg.parts %}
      {%- case part.kind %}
      {%- when "text" %}
    <div class="text">{{ part.text }}</div>
      {%- when "reasoning" %}
    <details class="payload reasoning"><summary><span class="payload-kind">Reasoning</span></summary><pre>{{ part.text }}</pre></details>
      {%- when "call", "result" %}
    <details class="payload {{ part.kind }}"{% if part.open %} open{% endif %}>
      <summary><span class="payload-kind">{% if part.kind == "call" %}Call{% else %}Result{% endif %}</span> <code>{{ part.tool }}</code> <span class="muted">{{ part.summary }}</span></summary>
      <pre>{{ part.text }}</pre>
    </details>
      {%- else %}
    <div class="muted">[{{ part.type }} part omitted]</div>
      {%- endcase %}
    {%- endfor %}
  </article>
  {%- endfor %}
</main>
</body>
</html>
