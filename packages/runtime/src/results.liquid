<!doctype html>
{%- comment -%}
  results.html for one run. Rendered by results_html.ts with output escaped
  by default, so transcript text can never become markup. The view it reads:
  the run's results.json fields, plus `title`, `stats`, `support` and the
  prepared `messages` (see prepareMessages).
{%- endcomment %}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
{% render "styles" %}
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <div class="meta">{{ provider }} · {{ model }}</div>
  <div class="meta">
    Run <code>{{ run_id }}</code> · {{ timestamp | datetime }}
    {%- if git_sha %} · commit
      {%- if git_url %} <a href="{{ git_url }}">{{ git_sha | slice: 0, 8 }}</a>
      {%- else %} {{ git_sha | slice: 0, 8 }}
      {%- endif %}
    {%- endif %}
  </div>
  {%- if support.size > 0 %}
  <div class="meta">
    {%- for s in support %}{% unless forloop.first %} · {% endunless %}{{ s.role }}: {{ s.model }}{% endfor -%}
  </div>
  {%- endif %}

  <div class="stats">
    <div class="stat"><div class="stat-label">Score</div><div class="stat-value">{% if score %}{{ score }}/10{% else %}Not scored{% endif %}</div>{% unless score %}<div class="muted">Run with --judge to score</div>{% endunless %}</div>
    <div class="stat"><div class="stat-label">Cost</div><div class="stat-value">{{ cost | format_cost }}</div></div>
    <div class="stat"><div class="stat-label">Customer turns</div><div class="stat-value">{{ customer_turns | format_number }}</div></div>
    <div class="stat"><div class="stat-label">Agent latency</div><div class="stat-value">{{ llm_latency_ms | format_latency }}</div></div>
  </div>

  {%- if error %}
  <section class="error"><h2>Error</h2><pre>{{ error }}</pre></section>
  {%- endif %}

  {%- if judge.criteria.size > 0 %}
  <section>
    <h2>Judge</h2>
    <table>
      <thead><tr><th></th><th>Criterion</th><th>Evidence</th></tr></thead>
      <tbody>
        {%- for c in judge.criteria %}
        <tr>
          {%- if c.met %}<td class="met">✓</td>{% else %}<td class="unmet">✗</td>{% endif -%}
          <td>{{ c.criterion }}</td><td class="muted">{{ c.evidence }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    {%- if reasoning %}<p class="muted">{{ reasoning }}</p>{% endif %}
  </section>
  {%- elsif reasoning %}
  <section><h2>Judge</h2><p>{{ reasoning }}</p></section>
  {%- endif %}

  {%- if usage_rows.size > 0 %}
  <section>
    <h2>Usage by role</h2>
    <table>
      <thead><tr><th>Role</th><th>Input</th><th>Cached</th><th>Output</th><th>Calls</th><th>Cost</th></tr></thead>
      <tbody>
        {%- for u in usage_rows %}
        <tr>
          <td>{{ u.role }}</td>
          <td>{{ u.input | format_number }}</td>
          <td>{{ u.cached_input | format_number }}</td>
          <td>{{ u.output | format_number }}</td>
          <td>{{ u.calls | format_number }}</td>
          <td>{{ u.cost_cents | format_cost }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>
  {%- endif %}

  <h2>Transcript</h2>
  {%- for msg in messages %}
  <article class="msg {{ msg.role }}">
    <header><span class="role">{{ msg.label }}</span><span class="muted">#{{ forloop.index }}</span></header>
    {%- for part in msg.parts %}
      {%- case part.kind %}
      {%- when "text" %}
    <div class="text">{{ part.text }}</div>
      {%- when "reasoning" %}
    <details class="payload reasoning"><summary><span class="payload-kind">Reasoning</span></summary><pre>{{ part.text }}</pre></details>
      {%- when "call", "result" %}
    <details class="payload {{ part.kind }}"{% if part.open %} open{% endif %}>
      <summary><span class="payload-kind">{% if part.kind == "call" %}Call{% else %}Result{% endif %}</span> <code>{{ part.tool }}</code> <span class="muted">{{ part.summary }}</span></summary>
      <pre>{{ part.text }}</pre>
    </details>
      {%- else %}
    <div class="muted">[{{ part.type }} part omitted]</div>
      {%- endcase %}
    {%- endfor %}
  </article>
  {%- endfor %}
</main>
</body>
</html>
