# Provider API keys. Any one is enough: the agent, the simulated customer and
# the judge run on OpenAI by default, else on the first provider with a key.
# bin/agent asks for a key when none is set, and can save it here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional base URL overrides, for pointing a provider at a compatible
# endpoint (a gateway, a local server). Gemini's default is
# https://generativelanguage.googleapis.com/v1beta.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
